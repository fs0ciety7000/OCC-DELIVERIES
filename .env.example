# Copier en .env pour docker compose (ne jamais committer .env)
OCC_PUBLIC_URL=https://eat.fs0ciety.org
OCC_ADMIN_EMAIL=admin@example.com
OCC_ADMIN_PASSWORD=change-me-please-1234
# Comptes utilisateurs promus admin du panneau /admin (e-mails séparés par des virgules)
OCC_ADMINS=
OCC_DEFAULT_LAT=50.4542
OCC_DEFAULT_LNG=3.9567
OCC_DEFAULT_LABEL=Mons
OCC_SEED_DEMO=true
OCC_PROVIDERS=ubereats,takeaway,deliveroo,weloveat
# Synchronisation automatique des restaurants et menus (Deliveroo, weloveat, sites Takeaway)
OCC_SYNC_ENABLED=true
# cron 5 champs, lu à l'heure de Bruxelles (défaut : chaque nuit à 03:30)
OCC_SYNC_CRON=30 3 * * *
# première synchronisation ~60 s après le démarrage si aucune n'a encore réussi
OCC_SYNC_ON_START=true
# Connexion avec Google (client OAuth « Application Web », redirection https://eat.fs0ciety.org/api/oauth2-redirect)
OCC_GOOGLE_CLIENT_ID=
OCC_GOOGLE_CLIENT_SECRET=
# E-mails (vérification, mot de passe oublié…). Vide = pas d'e-mail (ou réglages /_/ conservés)
OCC_SMTP_HOST=
OCC_SMTP_PORT=587
OCC_SMTP_USERNAME=
OCC_SMTP_PASSWORD=
# true = TLS implicite (défaut sur le port 465) ; sinon STARTTLS
OCC_SMTP_TLS=
OCC_MAIL_FROM=noreply@eat.fs0ciety.org
OCC_MAIL_FROM_NAME=OCC Deliveries
